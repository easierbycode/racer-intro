# Loaded only by `vite build --mode debug` (see the build:debug script).
#
# Vite's loadEnv promotes NODE_ENV from a .env file into VITE_USER_NODE_ENV,
# which is what computes config.isProduction — `--mode` alone does not. With
# isProduction false, vite-plugin-svelte stops force-clearing compilerOptions.dev
# (it force-disables it for production builds), so components compile with dev
# instrumentation, AND import.meta.env.DEV becomes true, which the esm-env shim
# already reads. One switch, so compile-time dev and runtime DEV cannot disagree.
#
# Only NODE_ENV=development is supported here; any other value is warned about
# and ignored. This file must stay committed — CI needs it for build:debug.
NODE_ENV=development

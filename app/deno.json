{
  // "auto", not "manual": there is no package.json here, so no npm client
  // ever populates app/node_modules, and manual mode then fails to resolve
  // Fresh's own npm dependencies (npm:@opentelemetry/api) unless you
  // remember to run `deno install` first. Auto lets Deno install them on
  // demand, so `deno task dev` works from a fresh clone.
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  // Match the style the app is actually written in. Without this, `deno fmt`
  // defaults to double quotes and semicolons and wants to rewrite every file,
  // which made `deno task check` fail out of the box and useless as a gate.
  // lineWidth 92, not the default 80: at 80 fmt rewraps a dozen lines this app
  // already fits comfortably, and at 94+ it starts *joining* lines that were
  // deliberately split. 91-93 is the window where it leaves the code alone; 92
  // sits in the middle of it.
  "fmt": { "singleQuote": true, "semiColons": false, "lineWidth": 92 },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*", "static/ui"],
  "imports": {
    "@/": "./",
    "@std/path": "jsr:@std/path@^1.0.0",
    // Import Fresh as "@fresh/core", never the bare "fresh". This app lives
    // inside a repo whose npm node_modules carries fresh@2.0.0 (the unrelated
    // Express-era "HTTP response freshness testing" package). Vite resolves
    // bare specifiers by walking up from app/, finds that one first and wins
    // over Deno's import map, so `import { createDefine } from 'fresh'` loads
    // the wrong module and dies with "createDefine is not a function". A
    // scoped name cannot collide with it — the same reason @fresh/plugin-vite
    // has always resolved fine. The bare alias stays mapped for `deno task
    // update` and any Fresh codegen that assumes it.
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/core": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}

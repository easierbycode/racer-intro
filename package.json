{
  "name": "racer-intro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CvS 'Expressway' style racer intro — pseudo-3D road, crash fireball, white-out, burning expressway. Svelte 5 + Phaser 4 via 5velte-ph4ser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "build:all": "npm run build && npm run build:debug",
    "preview": "vite preview",
    "build:ui": "vite build --config ui/vite.config.js"
  },
  "dependencies": {
    "5velte-ph4ser": "^1.0.1",
    "phaser": "^4.2.1",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitejs/devtools": "^0.4.10",
    "vite": "^8.2.0",
    "vite-devtools-svelte": "^0.3.0"
  }
}
